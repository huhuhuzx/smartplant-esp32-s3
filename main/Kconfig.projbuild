menu "SmartPlant"

config SMARTPLANT_WIFI_SSID
    string "Initial Wi-Fi SSID"
    default ""
    help
        Used when no Wi-Fi credentials have been saved on the device.
        ESP32-S3 supports 2.4 GHz networks only.

config SMARTPLANT_WIFI_PASSWORD
    string "Initial Wi-Fi password"
    default ""
    help
        Initial credentials are stored in local sdkconfig and embedded in firmware.
        Once provisioned, Wi-Fi can be changed through the touchscreen or device website.

endmenu
